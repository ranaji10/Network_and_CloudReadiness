\cf8 \cb7 root_agent = LlmAgent\cf9 \strokec9 (\cf8 \cb1 \strokec8 \
\cb7   name=\cf10 \strokec10 'GCP_Roadmap_Agent'\cf9 \strokec9 ,\cf8 \cb1 \strokec8 \
\cb7   model=GlobalGemini\cf9 \strokec9 (\cf8 \strokec8 model=\cf10 \strokec10 'gemini-3.1-pro-preview'\cf9 \strokec9 ),\cf8 \cb1 \strokec8 \
\cb7   description=\cf9 \strokec9 (\cf8 \cb1 \strokec8 \
\cb7       \cf10 \strokec10 'Orchestrates the discovery and roadmap generation pipeline across all specialized sub-agents.'\cf8 \cb1 \strokec8 \
\cb7   \cf9 \strokec9 ),\cf8 \cb1 \strokec8 \
\cb7   sub_agents=\cf9 \strokec9 [\cf8 \strokec8 ingestion_semantic_discovery\cf9 \strokec9 ,\cf8 \strokec8  footprint_sufficiency_evaluator\cf9 \strokec9 ,\cf8 \strokec8  high_confidence_roadmap_generator\cf9 \strokec9 ,\cf8 \strokec8  ccm_controls_curator\cf9 \strokec9 ,\cf8 \strokec8  dynamic_discovery_questionnaire\cf9 \strokec9 ,\cf8 \strokec8  assisted_discovery_roadmap_generator\cf9 \strokec9 ],\cf8 \cb1 \strokec8 \
\cb7   instruction=\cf10 \strokec10 'You are the Lead Cloud Migration Coordinator. You orchestrate discovery, evaluation, gap remediation, and GCP roadmap generation by delegating tasks to your specialized sub-agents.\\n\\nEXECUTION PIPELINE:\\n1. Discovery Intake:\\n   - When a user supplies infrastructure text, documentation, or links, invoke \\'Ingestion and Semantic Discovery\\'.\\n   - Receive the \\'technical_inventory\\' and \\'retained_files\\'.\\n\\n2. Sufficiency Evaluation:\\n   - Pass \\'technical_inventory\\' and \\'retained_files\\' to \\'Footprint Sufficiency Evaluator\\'.\\n   - Receive \\'confidence_score\\' (0\'96100), \\'pillar_breakdown\\', and \\'missing_information\\'.\\n\\n3. Conditional Routing Gate:\\n   - IF confidence_score >= 70:\\n     a. Route directly to \\'High Confidence Roadmap Generator\\' with all discovery and scoring data.\\n     b. Present the generated Markdown migration proposal to the user.\\n   - IF confidence_score < 70:\\n     a. Route to \\'CCM Controls Curator\\' to extract \\'missing_info_summary\\' and \\'curated_ccm_questions\\'.\\n     b. Trigger \\'Dynamic Discovery Questionnaire\\' to present the gaps and interview the user in chat.\\n     c. Once the user provides answers, route all baseline data and questionnaire responses to \\'Assisted Discovery Roadmap Generator\\'.\\n     d. Present the final synthesized migration report to the user.'\cf9 \strokec9 ,\cf8 \cb1 \strokec8 \
\cb7   tools=\cf9 \strokec9 [],\cf8 \cb1 \strokec8 \
