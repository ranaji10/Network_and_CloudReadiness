\cf6 \cb7 \strokec6 class\cf8 \strokec8  GlobalGemini\cf9 \strokec9 (\cf8 \strokec8 Gemini\cf9 \strokec9 ):\cf8 \cb1 \strokec8 \
\pard\pardeftab720\partightenfactor0
\cf8 \cb7   \cf10 \strokec10 """Pins the Vertex AI client to the `global` location.\cf8 \cb1 \strokec8 \
\
\pard\pardeftab720\partightenfactor0
\cf10 \cb7 \strokec10   gemini-3 series models are only served from `global`; the default ADK\cf8 \cb1 \strokec8 \
\cf10 \cb7 \strokec10   `Gemini` integration constructs a `google.genai.Client` whose location\cf8 \cb1 \strokec8 \
\cf10 \cb7 \strokec10   defaults to the AgentEngine instance's region (e.g. `us-central1`) and\cf8 \cb1 \strokec8 \
\cf10 \cb7 \strokec10   fails with model-not-found for these models. Subclassing per the override\cf8 \cb1 \strokec8 \
\cf10 \cb7 \strokec10   pattern documented on `google.adk.models.google_llm.Gemini` lets the agent\cf8 \cb1 \strokec8 \
\cf10 \cb7 \strokec10   keep running in its regional AgentEngine instance while routing the model\cf8 \cb1 \strokec8 \
\cf10 \cb7 \strokec10   request to the global endpoint.\cf8 \cb1 \strokec8 \
\cf10 \cb7 \strokec10   """\cf8 \cb1 \strokec8 \
\
\pard\pardeftab720\partightenfactor0
\cf8 \cb7   \cf6 \strokec6 @cached_property\cf8 \cb1 \strokec8 \
\cb7   \cf6 \strokec6 def\cf8 \strokec8  api_client\cf9 \strokec9 (\cf6 \strokec6 self\cf9 \strokec9 )\cf8 \strokec8  -> Client\cf9 \strokec9 :\cf8 \cb1 \strokec8 \
\cb7     \cf6 \strokec6 return\cf8 \strokec8  Client\cf9 \strokec9 (\cf8 \strokec8 vertexai=\cf6 \strokec6 True\cf9 \strokec9 ,\cf8 \strokec8  location=\cf10 \strokec10 "global"\cf9 \strokec9 )\cf8 \cb1 \strokec8 \
\
\
\cb7 ingestion_semantic_discovery = LlmAgent\cf9 \strokec9 (\cf8 \cb1 \strokec8 \
\cb7   name=\cf10 \strokec10 'ingestion_semantic_discovery'\cf9 \strokec9 ,\cf8 \cb1 \strokec8 \
\cb7   model=GlobalGemini\cf9 \strokec9 (\cf8 \strokec8 model=\cf10 \strokec10 'gemini-3.5-flash'\cf9 \strokec9 ),\cf8 \cb1 \strokec8 \
\cb7   description=\cf9 \strokec9 (\cf8 \cb1 \strokec8 \
\cb7       \cf10 \strokec10 'Analyzes input text and documentation to extract a technical inventory and list of retained reference items.'\cf8 \cb1 \strokec8 \
\cb7   \cf9 \strokec9 ),\cf8 \cb1 \strokec8 \
\cb7   sub_agents=\cf9 \strokec9 [],\cf8 \cb1 \strokec8 \
\cb7   instruction=\cf10 \strokec10 'You are the Ingestion and Semantic Discovery Specialist.\\n\\nRESPONSIBILITIES:\\n1. Semantic Classification:\\n   - Retain: Architecture diagrams, network topographies, database schemas, server/VM inventories, backup configurations, vendor agreements, and compliance audits (SOC2, ISO 27001, HIPAA, PCI-DSS).\\n   - Discard: Non-technical assets, marketing collateral, generic meeting transcripts, and invoices.\\n2. Fact Extraction:\\n   - Extract technical specifications across compute, storage, databases, networking, and identity.\\n3. Structured Output:\\n   - technical_inventory: Consolidated factual summary of discovered infrastructure.\\n   - retained_files: List of verified documentation artifacts. If input is sparse, state missing context explicitly.'\cf9 \strokec9 ,\cf8 \cb1 \strokec8 \
\cb7   tools=\cf9 \strokec9 [],\cf8 \cb1 \strokec8 \
\pard\pardeftab720\partightenfactor0
\cf9 \cb7 \strokec9 )\cf8 \cb1 \strokec8 \
\pard\pardeftab720\partightenfactor0
\cf8 \cb7 footprint_sufficiency_evaluator = LlmAgent\cf9 \strokec9 (\cf8 \cb1 \strokec8 \
\cb7   name=\cf10 \strokec10 'footprint_sufficiency_evaluator'\cf9 \strokec9 ,\cf8 \cb1 \strokec8 \
\cb7   model=GlobalGemini\cf9 \strokec9 (\cf8 \strokec8 model=\cf10 \strokec10 'gemini-3.5-flash'\cf9 \strokec9 ),\cf8 \cb1 \strokec8 \
\cb7   description=\cf9 \strokec9 (\cf8 \cb1 \strokec8 \
\cb7       \cf10 \strokec10 'Evaluates technical inventory completeness, outputting a confidence score, pillar breakdown, and missing information.'\cf8 \cb1 \strokec8 \
\cb7   \cf9 \strokec9 ),\cf8 \cb1 \strokec8 \
\cb7   sub_agents=\cf9 \strokec9 [],\cf8 \cb1 \strokec8 \
\cb7   instruction=\cf10 \strokec10 'You are the Footprint Sufficiency Evaluator.\\n\\nEvaluate \\'technical_inventory\\' across the five foundational migration pillars (0\'9620 points each, 100 total):\\n1. Compute and Runtime (20 pts): VM counts, on-prem servers, CPU/RAM specs, container/Kubernetes clusters, serverless functions, OS distributions.\\n2. Data and Storage (20 pts): Database engines (SQL Server, Oracle, PostgreSQL, MySQL), storage volumes, IOPS, file shares (NFS/SMB), backup policies, retention schedules.\\n3. Networking and Identity (20 pts): Identity providers (Active Directory, Okta, LDAP), VPN tunnels, interconnects, public/private CIDR blocks, VPC topologies, firewalls.\\n4. Security and Compliance (20 pts): Data residency rules, encryption at rest/transit standards, regulatory certifications, IAM policies, audit logging.\\n5. Cost and Licensing (20 pts): Enterprise agreements, software licenses (Windows Server/SQL Server with Software Assurance), hardware amortization.\\n\\nOUTPUT REQUIREMENTS:\\n- confidence_score: Integer from 0 to 100.\\n- pillar_breakdown: Detailed sufficiency analysis and score per pillar.\\n- missing_information: Bulleted list of critical missing technical data points.'\cf9 \strokec9 ,\cf8 \cb1 \strokec8 \
\cb7   tools=\cf9 \strokec9 [],\cf8 \cb1 \strokec8 \
\pard\pardeftab720\partightenfactor0
\cf9 \cb7 \strokec9 )\cf8 \cb1 \strokec8 \
\pard\pardeftab720\partightenfactor0
\cf8 \cb7 high_confidence_roadmap_generator = LlmAgent\cf9 \strokec9 (\cf8 \cb1 \strokec8 \
\cb7   name=\cf10 \strokec10 'high_confidence_roadmap_generator'\cf9 \strokec9 ,\cf8 \cb1 \strokec8 \
\cb7   model=GlobalGemini\cf9 \strokec9 (\cf8 \strokec8 model=\cf10 \strokec10 'gemini-3.5-flash'\cf9 \strokec9 ),\cf8 \cb1 \strokec8 \
\cb7   description=\cf9 \strokec9 (\cf8 \cb1 \strokec8 \
\cb7       \cf10 \strokec10 'Generates a comprehensive Markdown GCP migration roadmap report for high-confidence architectures.'\cf8 \cb1 \strokec8 \
\cb7   \cf9 \strokec9 ),\cf8 \cb1 \strokec8 \
\cb7   sub_agents=\cf9 \strokec9 [],\cf8 \cb1 \strokec8 \
\cb7   instruction=\cf10 \strokec10 'You are the High Confidence GCP Roadmap Generator.\\n\\nUsing \\'technical_inventory\\', \\'pillar_breakdown\\', and \\'confidence_score\\' (>= 70), generate a production-ready Cloud Migration Proposal in Markdown:\\n1. Executive Header:\\n   - Infrastructure Footprint Confidence Score (out of 100).\\n   - Methodology breakdown across the 5 pillars.\\n   - Inventory of cited source files supporting the assessment.\\n2. Service Mapping (Google Cloud Well-Architected Framework):\\n   - Databases -> Cloud SQL, AlloyDB, or Cloud Spanner.\\n   - Applications/VMs -> Google Kubernetes Engine (GKE), Cloud Run, or Compute Engine.\\n   - Analytics -> BigQuery, Dataproc, and Looker.\\n   - Storage -> Cloud Storage (Standard/Nearline/Coldline/Archive) and Filestore.\\n   - Network & Security -> Cloud Interconnect/Cloud VPN, Cloud Armor, and Cloud Identity.\\n3. Migration Wave Breakdown:\\n   - Wave 1 (Quick Wins): Stateless web apps, test/dev environments, batch jobs.\\n   - Wave 2 (Core Workloads): Production application backends, transactional databases, internal APIs.\\n   - Wave 3 (Legacy Monoliths): Complex enterprise monoliths, tightly coupled legacy databases.\\n4. Additional Sections: Architecture topology matrix, risk mitigation strategy, and wave schedule.'\cf9 \strokec9 ,\cf8 \cb1 \strokec8 \
\cb7   tools=\cf9 \strokec9 [],\cf8 \cb1 \strokec8 \
\pard\pardeftab720\partightenfactor0
\cf9 \cb7 \strokec9 )\cf8 \cb1 \strokec8 \
\pard\pardeftab720\partightenfactor0
\cf8 \cb7 ccm_controls_curator = LlmAgent\cf9 \strokec9 (\cf8 \cb1 \strokec8 \
\cb7   name=\cf10 \strokec10 'ccm_controls_curator'\cf9 \strokec9 ,\cf8 \cb1 \strokec8 \
\cb7   model=GlobalGemini\cf9 \strokec9 (\cf8 \strokec8 model=\cf10 \strokec10 'gemini-3.5-flash'\cf9 \strokec9 ),\cf8 \cb1 \strokec8 \
\cb7   description=\cf9 \strokec9 (\cf8 \cb1 \strokec8 \
\cb7       \cf10 \strokec10 'Identifies compliance and network control gaps, outputting a missing info summary and targeted CCM questions.'\cf8 \cb1 \strokec8 \
\cb7   \cf9 \strokec9 ),\cf8 \cb1 \strokec8 \
\cb7   sub_agents=\cf9 \strokec9 [],\cf8 \cb1 \strokec8 \
\cb7   instruction=\cf10 \strokec10 'You are the Cloud Controls Matrix (CCM) and Network Security Curator.\\n\\nAnalyze \\'pillar_breakdown\\', \\'technical_inventory\\', and \\'missing_information\\':\\n1. Summarize missing technical data into an actionable, bulleted \\'missing_info_summary\\'.\\n2. Map architecture ambiguities to the Cloud Controls Matrix (CCM v4.1.0) and select targeted CAIQ questions:\\n   - IS-03: Network Security (firewall policies, perimeter controls, transit filtering)\\n   - IS-06: Segmentation and Segregation (VPC peering, microsegmentation, DMZ isolation)\\n   - IS-07: Migration to Cloud Environments (interconnects, direct peering, VPN encryption)\\n   - IS-08: Network Architecture Documentation (IP schemes, CIDR allocations, routing tables)\\n   - IS-09: Network Defense (IDS/IPS, DDoS protection, WAF configurations)\\n3. Output \\'missing_info_summary\\' and \\'curated_ccm_questions\\'.'\cf9 \strokec9 ,\cf8 \cb1 \strokec8 \
\cb7   tools=\cf9 \strokec9 [],\cf8 \cb1 \strokec8 \
\pard\pardeftab720\partightenfactor0
\cf9 \cb7 \strokec9 )\cf8 \cb1 \strokec8 \
\pard\pardeftab720\partightenfactor0
\cf8 \cb7 dynamic_discovery_questionnaire = LlmAgent\cf9 \strokec9 (\cf8 \cb1 \strokec8 \
\cb7   name=\cf10 \strokec10 'dynamic_discovery_questionnaire'\cf9 \strokec9 ,\cf8 \cb1 \strokec8 \
\cb7   model=GlobalGemini\cf9 \strokec9 (\cf8 \strokec8 model=\cf10 \strokec10 'gemini-3.5-flash'\cf9 \strokec9 ),\cf8 \cb1 \strokec8 \
\cb7   description=\cf9 \strokec9 (\cf8 \cb1 \strokec8 \
\cb7       \cf10 \strokec10 'Interactively collects five essential architecture and infrastructure details from the user.'\cf8 \cb1 \strokec8 \
\cb7   \cf9 \strokec9 ),\cf8 \cb1 \strokec8 \
\cb7   sub_agents=\cf9 \strokec9 [],\cf8 \cb1 \strokec8 \
\cb7   instruction=\cf10 \strokec10 'You are the Dynamic Discovery Consultant.\\n\\nWhen triggered, inform the user:\\n\\"The discovered documents provided a confidence score of [confidence_score]%, which is below the 70% threshold required for automated migration planning.\\"\\n\\nPresent \\'missing_info_summary\\' and \\'curated_ccm_questions\\', then collect user responses across:\\n1. Networking and Identity Specifications\\n2. CCM Network Architecture Responses\\n3. Compute and Runtime Details\\n4. Missing Infrastructure Information Details\\n5. Data and Storage Details\\n6. Security, Governance, and Compliance Constraints\\n7. Licensing and Cost Considerations\\n\\nFormat all collected information into a clean structured payload for the final roadmap generator.'\cf9 \strokec9 ,\cf8 \cb1 \strokec8 \
\cb7   tools=\cf9 \strokec9 [],\cf8 \cb1 \strokec8 \
\pard\pardeftab720\partightenfactor0
\cf9 \cb7 \strokec9 )\cf8 \cb1 \strokec8 \
\pard\pardeftab720\partightenfactor0
\cf8 \cb7 assisted_discovery_roadmap_generator = LlmAgent\cf9 \strokec9 (\cf8 \cb1 \strokec8 \
\cb7   name=\cf10 \strokec10 'assisted_discovery_roadmap_generator'\cf9 \strokec9 ,\cf8 \cb1 \strokec8 \
\cb7   model=GlobalGemini\cf9 \strokec9 (\cf8 \strokec8 model=\cf10 \strokec10 'gemini-3.5-flash'\cf9 \strokec9 ),\cf8 \cb1 \strokec8 \
