        "required": [
          "source_uri"
        ],
        "title": "AssessRequest",
        "type": "object"
      },
      "Body_create_from_upload_assessments_upload_post": {
        "properties": {
          "files": {
            "items": {
              "contentMediaType": "application/octet-stream",
              "type": "string"
            },
            "title": "Files",
            "type": "array"
          }
        },
        "required": [
          "files"
        ],
        "title": "Body_create_from_upload_assessments_upload_post",
        "type": "object"
      },
      "Body_create_job_from_upload_jobs_upload_post": {
