        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "QuestionnaireAnswer": {
        "description": "One answered discovery item. `question` is optional: the question as shown in the report.",
        "properties": {
          "answer": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Answer",
            "type": "string"
          },
          "check_id": {
            "title": "Check Id",
            "type": "string"
