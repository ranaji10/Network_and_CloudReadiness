# Copy to .env for local runs. Never commit .env. Every value is optional; defaults run fully offline.
# --- Provider selection (portability: switch clouds here, never in code) ---
READINESS_PROVIDER=local            # local | gcp | aws
READINESS_LLM_PROVIDER=mock         # mock | gemini | anthropic
READINESS_LLM_MODEL=                # e.g. gemini-3.5-flash | claude-sonnet-5-5 ; blank = adapter default
READINESS_ALLOW_LLM_EGRESS=false    # must be true before any real LLM provider is used
READINESS_USE_LLM_JUDGE=false       # refine rule verdicts per pillar with the model (redacted text only)
READINESS_USE_LLM_CLASSIFIER=false  # re-classify documents the keyword classifier is unsure about (redacted samples)
# --- GCP (only read when READINESS_PROVIDER=gcp or LLM provider=gemini via Vertex) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
READINESS_GEMINI_LOCATION=global     # Vertex location for Gemini calls; stays global even when the runtime region differs
READINESS_GCS_BUCKET_UPLOADS=
READINESS_GCS_BUCKET_REPORTS=
# --- AWS (only read when READINESS_PROVIDER=aws) ---
AWS_REGION=
READINESS_S3_BUCKET_UPLOADS=
READINESS_S3_BUCKET_REPORTS=
# --- Secrets: prefer the platform secret store; env vars are for local dev only ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
READINESS_API_TOKEN=                # bearer token for the HTTP API; blank disables the API unless READINESS_AUTH_DISABLED=true
READINESS_AUTH_DISABLED=false
# --- Guardrails ---
READINESS_REDACTION_MODE=pseudonymize   # off | mask | pseudonymize
READINESS_INCLUDE_EVIDENCE_SNIPPETS=false
READINESS_TENANT_ID=local
READINESS_WORKSPACE_DIR=./workspace
