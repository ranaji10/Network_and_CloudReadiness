# Copy to dev.tfvars (git-ignored). Only this file knows which account/project you are on.
project_id            = "REPLACE-with-your-project-id"
region                = "asia-south1"
env                   = "dev"
deploy_cloud_run      = true
allow_unauthenticated = false
llm_provider          = "mock"       # switch to gemini once READINESS_ALLOW_LLM_EGRESS policy is signed off
allow_llm_egress      = false
use_cmek              = false
report_retention_days = 90
create_build_trigger  = false        # the repo already has a hand-made trigger; see trigger.tf to import
github_connection     = ""
github_repo_uri       = ""
billing_account       = ""           # "XXXXXX-XXXXXX-XXXXXX" to enable the budget alert
monthly_budget_usd    = 50
